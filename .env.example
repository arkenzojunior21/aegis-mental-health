# Salin file ini menjadi .env, lalu isi API key dari Google AI Studio.
# Jangan kirim file .env ke GitHub atau orang lain.
GEMINI_API_KEY=PASTE_API_KEY_ANDA_DI_SINI
GEMINI_MODEL=gemini-2.5-flash

# Opsional: isi saat backend MySQL benar-benar dibuat.
# Jangan pernah pakai VITE_ untuk kredensial database karena nilainya akan terlihat di browser.
MYSQL_HOST=YOUR_AIVEN_HOST
MYSQL_PORT=21797
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=YOUR_DATABASE_PASSWORD
MYSQL_SSL_MODE=REQUIRED
# Opsional namun direkomendasikan bila Anda telah mengunduh CA certificate Aiven.
# Contoh: MYSQL_CA_CERT_PATH=ca.pem
MYSQL_CA_CERT_PATH=
